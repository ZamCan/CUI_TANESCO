<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground.

  Deliberately a plain meter silhouette: a rectangular device with a display bar
  and a keypad grid. No lightning bolt, no gradient, no glow. The icon should
  read as an instrument at 48dp, and decorative energy motifs are exactly the
  aesthetic this project avoids.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Device body -->
    <path
        android:fillColor="#EDE9E2"
        android:pathData="M34,24 L74,24 A5,5 0 0 1 79,29 L79,79 A5,5 0 0 1 74,84 L34,84 A5,5 0 0 1 29,79 L29,29 A5,5 0 0 1 34,24 Z" />

    <!-- Display window -->
    <path
        android:fillColor="#2C3326"
        android:pathData="M36,32 L72,32 L72,44 L36,44 Z" />

    <!-- Keypad: three rows of three keys -->
    <path android:fillColor="#8C8579" android:pathData="M36,50 L44,50 L44,56 L36,56 Z" />
    <path android:fillColor="#8C8579" android:pathData="M50,50 L58,50 L58,56 L50,56 Z" />
    <path android:fillColor="#8C8579" android:pathData="M64,50 L72,50 L72,56 L64,56 Z" />

    <path android:fillColor="#8C8579" android:pathData="M36,60 L44,60 L44,66 L36,66 Z" />
    <path android:fillColor="#8C8579" android:pathData="M50,60 L58,60 L58,66 L50,66 Z" />
    <path android:fillColor="#8C8579" android:pathData="M64,60 L72,60 L72,66 L64,66 Z" />

    <path android:fillColor="#8C8579" android:pathData="M36,70 L44,70 L44,76 L36,76 Z" />
    <path android:fillColor="#8C8579" android:pathData="M50,70 L58,70 L58,76 L50,76 Z" />
    <path android:fillColor="#8C8579" android:pathData="M64,70 L72,70 L72,76 L64,76 Z" />
</vector>
